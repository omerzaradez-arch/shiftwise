DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiftwise
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shiftwise
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-256-bit-secret-key-change-this
CORS_ORIGINS=["http://localhost:3000"]
OPTIMIZER_TIME_LIMIT_SECONDS=30

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Password resets go by email whenever both of these are set and the manager has
# an address on file. RESEND_FROM must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=ShiftWise <no-reply@yourdomain.com>

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Which provider sends messages and which webhook is mounted: meta | twilio
WHATSAPP_PROVIDER=meta

# Meta Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=

# Approved template names. Leave blank until Meta approves them — the scheduler
# jobs then fall back to free-form interactive messages, which only reach
# employees inside the 24h customer-service window.
WHATSAPP_TEMPLATE_AVAILABILITY=
WHATSAPP_TEMPLATE_SHIFT_START=
WHATSAPP_TEMPLATE_SHIFT_LATE=
WHATSAPP_TEMPLATE_SCHEDULE_PUBLISHED=
WHATSAPP_TEMPLATE_SWAP_REQUEST=
WHATSAPP_TEMPLATE_SWAP_ACCEPTED=
WHATSAPP_TEMPLATE_ADMIN_REGISTRATION=
WHATSAPP_TEMPLATE_PASSWORD_RESET=
WHATSAPP_TEMPLATE_LANG=he

# Legacy Twilio path — only needed when WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
